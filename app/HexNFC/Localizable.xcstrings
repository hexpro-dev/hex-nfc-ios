        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是另一个标签。"
          }
        }
      }
    },
    "The card accepted every step, but reading it back didn't show the setup. Scan it to check.": {
      "comment": "DESFire Format error.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبلت البطاقة كل الخطوات، لكن القراءة اللاحقة لم تُظهر الإعداد. امسحها للتحقق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta aceptó todos los pasos, pero al leerla de nuevo no apareció la configuración. Escanéala para comprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte a accepté chaque étape, mais la relecture n'a pas montré la configuration. Scannez-la pour vérifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードはすべての手順を受け付けましたが、読み戻しでは設定が確認できませんでした。スキャンして確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão aceitou todas as etapas, mas a releitura não mostrou a configuração. Escaneie-o para conferir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片接受了每一步，但回读时未显示该设置。请扫描确认。"
          }
        }
      }
    },
    "The card answered, but reading it back still shows applications on it. Scan it to check.": {
      "comment": "Remove NDEF setup error.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استجابت البطاقة، لكن القراءة اللاحقة ما زالت تُظهر تطبيقات عليها. امسحها للتحقق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta respondió, pero al leerla de nuevo todavía muestra aplicaciones. Escanéala para comprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte a répondu, mais la relecture montre encore des applications. Scannez-la pour vérifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードは応答しましたが、読み戻すとまだアプリケーションが残っています。スキャンして確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão respondeu, mas a releitura ainda mostra aplicações nele. Escaneie-o para conferir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片已响应，但回读时仍显示有应用。请扫描确认。"
          }
        }
      }
    },
    "The card didn't answer the way a DESFire does, so nothing was changed.": {
      "comment": "Remove NDEF setup error.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُجب البطاقة كما تُجيب بطاقات DESFire، لذا لم يتغير شيء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta no respondió como responde una DESFire, así que no se cambió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte n'a pas répondu comme le fait une DESFire, rien n'a donc été modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードが DESFire として想定どおりに応答しなかったため、何も変更していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão não respondeu como um DESFire responde, então nada foi alterado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片的响应与 DESFire 不符，因此未做任何更改。"
          }
        }
      }
    },
    "The card didn't answer the way a DESFire does, so nothing was written.": {
      "comment": "DESFire Format error.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُجب البطاقة كما تُجيب بطاقات DESFire، لذا لم تتم أي كتابة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta no respondió como responde una DESFire, así que no se escribió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte n'a pas répondu comme le fait une DESFire, rien n'a donc été écrit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードが DESFire として想定どおりに応答しなかったため、何も書き込んでいません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão não respondeu como um DESFire responde, então nada foi gravado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片的响应与 DESFire 不符，因此未写入任何内容。"
          }
        }
      }
    },
    "The card is partly set up. Tap Format again to finish.": {
      "comment": "DESFire Format error. The card stopped answering partway. Names the Format operation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعدّت البطاقة جزئيًا. اضغط «تهيئة» مرة أخرى لإكمال الإعداد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta está configurada a medias. Toca Formatear otra vez para terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte est partiellement configurée. Touchez à nouveau Formater pour terminer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードは途中まで設定されています。もう一度「フォーマット」をタップして完了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão está configurado pela metade. Toque em Formatar de novo para concluir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片只完成了部分设置。请再次轻点「格式化」以完成。"
          }
        }
      }
    },
    "The card may already be blank. Scan it to check.": {
      "comment": "Remove NDEF setup error. The card stopped answering after the wipe was sent.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما أصبحت البطاقة فارغة بالفعل. امسحها للتحقق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que la tarjeta ya esté en blanco. Escanéala para comprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte est peut-être déjà vierge. Scannez-la pour vérifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードはすでに空になっている可能性があります。スキャンして確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão talvez já esteja em branco. Escaneie-o para conferir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片可能已经是空白的。请扫描确认。"
          }
        }
      }
    },
    "The card may be partly set up. Scan it to check, or tap Format again.": {
      "comment": "DESFire Format error. The card stopped answering on the last step. Names the Format operation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما أُعدّت البطاقة جزئيًا. امسحها للتحقق، أو اضغط «تهيئة» مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que la tarjeta esté configurada a medias. Escanéala para comprobarlo o toca Formatear otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte est peut-être partiellement configurée. Scannez-la pour vérifier, ou touchez à nouveau Formater."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードが途中まで設定されている可能性があります。スキャンして確認するか、もう一度「フォーマット」をタップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão pode estar configurado pela metade. Escaneie-o para conferir ou toque em Formatar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片可能只完成了部分设置。请扫描确认，或再次轻点「格式化」。"
          }
        }
      }
    },
    "The card refused part of the setup. Use Remove NDEF setup to start over.": {
      "comment": "DESFire Format error. Names the Remove NDEF setup operation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت البطاقة جزءًا من الإعداد. استخدم «إزالة إعداد NDEF» للبدء من جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta rechazó parte de la configuración. Usa Quitar configuración NDEF para empezar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte a refusé une partie de la configuration. Utilisez Retirer la configuration NDEF pour recommencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードが設定の一部を拒否しました。「NDEF 設定を削除」でやり直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão recusou parte da configuração. Use Remover configuração NDEF para começar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片拒绝了部分设置。请使用「移除 NDEF 设置」重新开始。"
          }
        }
      }
    },
    "The card refused the setup. Scan it to see what it holds.": {
      "comment": "DESFire Format error.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت البطاقة الإعداد. امسحها لترى ما تحمله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta rechazó la configuración. Escanéala para ver qué contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte a refusé la configuration. Scannez-la pour voir ce qu'elle contient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードが設定を拒否しました。スキャンして内容を確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão recusou a configuração. Escaneie-o para ver o que ele contém."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片拒绝了设置。请扫描卡片查看其中内容。"
          }
        }
      }
    },
    "The card refused to remove the setup. Scan it to see what it holds.": {
      "comment": "Remove NDEF setup error.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت البطاقة إزالة الإعداد. امسحها لترى ما تحمله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta se negó a quitar la configuración. Escanéala para ver qué contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte a refusé de retirer la configuration. Scannez-la pour voir ce qu'elle contient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードが設定の削除を拒否しました。スキャンして内容を確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão recusou a remoção da configuração. Escaneie-o para ver o que ele contém."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片拒绝移除设置。请扫描卡片查看其中内容。"
          }
        }
      }
    },
    "The chip's attempt limit is not set from here. It lives in Operations, under Dangerous Actions, because it is armed against one tag at a time and cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُضبط حد محاولات الشريحة من هنا. يوجد ضمن العمليات في قسم إجراءات خطِرة، لأنه يُفعَّل على بطاقة واحدة في كل مرة ولا يمكن التراجع عنه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite de intentos del chip no se configura aquí. Está en Operaciones, dentro de Acciones peligrosas, porque se activa sobre una etiqueta a la vez y no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de tentatives de la puce ne se règle pas ici. Elle se trouve dans Opérations, sous Actions dangereuses, car elle s'applique à un seul tag à la fois et ne peut pas être annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チップの試行回数の上限はここでは設定しません。1 枚のタグごとに適用され、取り消せないため、「操作」内の「危険な操作」にあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de tentativas do chip não é configurado aqui. Ele fica em Operações, em Ações perigosas, porque é aplicado a uma etiqueta por vez e não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "芯片的尝试次数上限不在此处设置。它位于“操作”中的“危险操作”下，因为它针对单个标签生效且无法撤销。"
          }
        }
      }
    },
    "The data groups match the hash list in the chip's security object. That object's own signature isn't verified, so this is not proof the data is unaltered or a check of the passport's authenticity.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطابق مجموعات البيانات مع قائمة البصمات في كائن الأمان داخل الشريحة. لم يُتحقق من توقيع ذلك الكائن نفسه، لذا هذا ليس إثباتًا بأن البيانات لم تُغيَّر ولا فحصًا لصحة جواز السفر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos de datos coinciden con la lista de hashes del objeto de seguridad del chip. La firma de ese objeto no se verifica, así que esto no prueba que los datos estén inalterados ni comprueba la autenticidad del pasaporte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes de données correspondent à la liste d'empreintes de l'objet de sécurité de la puce. La signature de cet objet n'est pas vérifiée : ce n'est donc pas une preuve que les données sont intactes, ni un contrôle d'authenticité du passeport."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データグループはチップのセキュリティオブジェクト内のハッシュ一覧と一致しています。ただしそのオブジェクト自体の署名は検証していないため、データが改変されていない証明にも、パスポートの真正性の確認にもなりません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os grupos de dados correspondem à lista de hashes do objeto de segurança do chip. A assinatura desse objeto não é verificada, então isto não prova que os dados estejam inalterados nem confere a autenticidade do passaporte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各数据组与芯片安全对象中的哈希列表一致。该对象自身的签名未经验证,因此这既不能证明数据未被改动,也不是对护照真伪的核验。"
          }
        }
      }
    },
    "The factory default password is what opened this tag, so an earlier removal had already gone through on it. The password you were keeping for this tag is not the one it holds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة المرور الافتراضية للمصنع هي التي فتحت هذه البطاقة، أي أن إزالة سابقة كانت قد تمت عليها بالفعل. كلمة المرور التي كنت تحتفظ بها لهذه البطاقة ليست الكلمة التي تحملها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña predeterminada de fábrica es la que ha abierto esta etiqueta, así que una eliminación anterior sí se había aplicado. La contraseña que guardabas para esta etiqueta no es la que tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le mot de passe d'usine qui a ouvert ce tag, donc une suppression précédente avait bien abouti. Le mot de passe que vous conserviez pour ce tag n'est pas celui qu'il contient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグを開いたのは工場出荷時のパスワードでした。つまり以前の削除は実際には完了していたことになります。このタグ用に控えていたパスワードは、タグが保持しているものではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi a senha padrão de fábrica que abriu esta etiqueta, ou seja, uma remoção anterior já tinha sido aplicada. A senha que você guardava para esta etiqueta não é a que ela tem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开这枚标签的是出厂默认密码，说明先前的移除其实已经生效。你为这枚标签保存的密码并不是它当前持有的密码。"
          }
        }
      }
    },
    "The frame is processed on-device. Nothing is uploaded.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم معالجة الصورة على الجهاز فقط. لا يتم رفع أي شيء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fotograma se procesa en el dispositivo. No se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image est traitée sur l'appareil. Rien n'est envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームはデバイス上で処理されます。アップロードはされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadro é processado no dispositivo. Nada é enviado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像在本机处理,不会上传任何内容。"
          }
        }
      }
    },
    "The last 50 tags you scan show up here. Pin one to keep it.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا آخر 50 بطاقة مسحتها. ثبّت واحدة للاحتفاظ بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen las últimas 50 etiquetas que escanees. Fija una para conservarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 50 derniers tags scannés apparaissent ici. Épinglez-en un pour le conserver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近 50 件のスキャンしたタグがここに表示されます。ピン留めすると残せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas 50 etiquetas que você ler aparecem aqui. Fixe uma para mantê-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里显示最近扫描的 50 个标签。置顶即可保留。"
          }
        }
      }
    },
    "The message couldn't be accepted. Check the email address and try again.": {
      "comment": "Feedback form. Shown when the service refused the message.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر قبول الرسالة. تحقق من عنوان البريد الإلكتروني وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido aceptar el mensaje. Comprueba la dirección de correo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n'a pas pu être accepté. Vérifiez l'adresse e-mail et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを受け付けられませんでした。メールアドレスを確認して、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aceitar a mensagem. Confira o endereço de e-mail e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法接收这条留言。请检查电子邮件地址后重试。"
          }
        }
      }
    },
    "The next tap will present this tag's factory default password (FF FF FF FF) instead of the one you entered.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستقدّم اللمسة التالية كلمة المرور الافتراضية للمصنع (FF FF FF FF) بدلاً من التي أدخلتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El siguiente acercamiento presentará la contraseña predeterminada de fábrica (FF FF FF FF) en lugar de la que has introducido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain passage présentera le mot de passe d'usine (FF FF FF FF) et non celui que vous avez saisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にかざしたときは、入力したパスワードではなく工場出荷時のパスワード (FF FF FF FF) を送信します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima aproximação vai apresentar a senha padrão de fábrica (FF FF FF FF) em vez da que você digitou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次贴合标签时将发送出厂默认密码 (FF FF FF FF)，而不是你输入的密码。"
          }
        }
      }
    },
    "The next write takes two taps: one to read the tag's ID, which you type to confirm, then one to make the change.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب الكتابة التالية تقريب البطاقة مرتين: مرة لقراءة معرّف البطاقة الذي تكتبه للتأكيد، ثم مرة لتنفيذ التغيير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima escritura requiere dos acercamientos: uno para leer el ID de la etiqueta, que escribes para confirmarlo, y otro para hacer el cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine écriture demande deux passages : un pour lire l'identifiant du tag, que vous saisissez pour le confirmer, puis un pour appliquer la modification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の書き込みではタグを 2 回かざします。1 回目でタグの ID を読み取り、それを入力して確認したうえで、2 回目に変更を行います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima gravação exige duas aproximações: um para ler o ID da etiqueta, que você digita para confirmar, e outro para fazer a alteração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次写入需要贴合两次：一次读取标签 ID，由你输入确认，然后再写入更改。"
          }
        }
      }
    },
    "The password was saved to the tag, but protection did not switch on. Hold the tag against the phone again to finish.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظت كلمة المرور على البطاقة، لكن الحماية لم تُفعَّل. قرّب البطاقة من الهاتف مرة أخرى لإكمال العملية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña se guardó en la etiqueta, pero la protección no se activó. Acerca de nuevo la etiqueta al teléfono para terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe a été enregistré sur le tag, mais la protection ne s'est pas activée. Approchez à nouveau le tag du téléphone pour terminer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードはタグに保存されましたが、保護は有効になりませんでした。もう一度タグを端末にかざして完了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A senha foi salva na etiqueta, mas a proteção não foi ativada. Aproxime a etiqueta do telefone novamente para terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码已保存到标签，但保护未开启。请再次将标签贴近手机以完成操作。"
          }
        }
      }
    },
    "The same passphrase always produces the same key, so you can protect a whole stack of tags without storing anything. Anyone who guesses the passphrase gets the key, so make it long.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتج عبارة المرور نفسها المفتاح نفسه دائمًا، فيمكنك حماية رزمة كاملة من البطاقات دون تخزين أي شيء. ومن يخمّن العبارة يحصل على المفتاح، لذا اجعلها طويلة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma frase de contraseña produce siempre la misma clave, así que puedes proteger un montón de etiquetas sin guardar nada. Quien adivine la frase obtiene la clave, así que hazla larga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une même phrase secrète produit toujours la même clé : vous pouvez donc protéger toute une pile de tags sans rien stocker. Quiconque devine la phrase obtient la clé, alors faites-la longue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じパスフレーズからは常に同じ鍵が生成されるので、何も保存せずにタグの束をまとめて保護できます。パスフレーズを推測されれば鍵も知られるため、長くしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesma frase secreta sempre gera a mesma chave, então você pode proteger uma pilha inteira de etiquetas sem guardar nada. Quem adivinhar a frase obtém a chave, então faça-a longa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个口令短语始终生成同一个密钥,因此你可以在不保存任何东西的情况下保护一整叠标签。猜到口令的人就拿到了密钥,所以请设置得长一些。"
          }
        }
      }
    },
    "The scan timed out. Hold the tag steady against the top of the phone and try again. If one particular tag times out every time, it may be a MIFARE Classic, which iPhone can't read (an iOS limitation, not a fault in the tag).": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة المسح. أبقِ البطاقة ثابتة عند أعلى الهاتف وحاول مجددًا. وإذا انتهت المهلة مع بطاقة معيّنة في كل مرة، فقد تكون MIFARE Classic التي لا يستطيع iPhone قراءتها (قيد في iOS، لا عيب في البطاقة)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha agotado el tiempo de escaneo. Mantén la etiqueta firme en la parte superior del teléfono e inténtalo de nuevo. Si con una etiqueta concreta se agota el tiempo cada vez, puede que sea una MIFARE Classic, que el iPhone no puede leer (una limitación de iOS, no un fallo de la etiqueta)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai du scan a expiré. Maintenez le tag immobile contre le haut du téléphone et réessayez. Si le délai expire à chaque fois avec un même tag, il s'agit peut-être d'un MIFARE Classic, que l'iPhone ne peut pas lire (une limite d'iOS, pas un défaut du tag)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンがタイムアウトしました。タグを端末の上部に固定したまま、もう一度お試しください。特定のタグだけ毎回タイムアウトする場合、iPhone が読めない MIFARE Classic かもしれません(iOS の制限であり、タグの不具合ではありません)。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de leitura se esgotou. Mantenha a etiqueta firme na parte superior do telefone e tente de novo. Se o tempo se esgotar sempre com uma mesma etiqueta, pode ser uma MIFARE Classic, que o iPhone não consegue ler (uma limitação do iOS, não um defeito da etiqueta)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描超时。请将标签稳定贴在手机顶部后重试。如果某个标签每次都超时,它可能是 iPhone 无法读取的 MIFARE Classic(这是 iOS 的限制,并非标签故障)。"
          }
        }
      }
    },
    "The secret is stored only on this device (Keychain). It never syncs or travels in an export.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزَّن السر على هذا الجهاز فقط (سلسلة المفاتيح). لا يُزامَن ولا يخرج ضمن أي تصدير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El secreto se guarda solo en este dispositivo (Llavero). Nunca se sincroniza ni viaja en una exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le secret est stocké uniquement sur cet appareil (trousseau). Il n'est jamais synchronisé ni inclus dans un export."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットはこのデバイス(キーチェーン)にのみ保存されます。同期されることも、書き出しに含まれることもありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O segredo fica guardado apenas neste dispositivo (Chaveiro). Ele nunca sincroniza nem viaja em uma exportação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码或密钥仅存储在本设备(钥匙串)中。它不会同步,也不会随导出文件外流。"
          }
        }
      }
    },
    "The tag acknowledged the write, but this tap couldn't read the byte back. Start the operation again: the first tap reports the limit the tag is holding.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقرّت البطاقة بعملية الكتابة، لكن تعذّرت قراءة البايت مرة أخرى في هذه اللمسة. ابدأ العملية من جديد: تعرض اللمسة الأولى الحد المخزَّن على البطاقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta confirmó la escritura, pero en este acercamiento no se pudo volver a leer el byte. Inicia la operación de nuevo: el primer acercamiento indica el límite que tiene la etiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tag a accusé réception de l'écriture, mais ce passage n'a pas pu relire l'octet. Relancez l'opération : le premier passage indique la limite enregistrée sur le tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグは書き込みを受理しましたが、今回のタップではバイトを読み戻せませんでした。操作をやり直してください。最初のタップでタグに設定されている上限を確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta confirmou a gravação, mas esta aproximação não conseguiu reler o byte. Inicie a operação novamente: a primeira aproximação informa o limite que a etiqueta tem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签已确认写入，但本次贴合未能读回该字节。请重新开始此操作：第一次贴合会显示标签当前的上限。"
          }
        }
      }
    },
    "The tag is still unprotected, and the password you entered was not saved to it. Hold the tag against the phone again to try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال البطاقة غير محمية، ولم تُحفظ عليها كلمة المرور التي أدخلتها. قرّب البطاقة من الهاتف مرة أخرى للمحاولة من جديد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta sigue sin protección y la contraseña que has introducido no se guardó en ella. Acerca de nuevo la etiqueta al teléfono para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tag n'est toujours pas protégé et le mot de passe que vous avez saisi n'y a pas été enregistré. Approchez à nouveau le tag du téléphone pour réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグは保護されていないままで、入力したパスワードも保存されていません。もう一度タグを端末にかざしてやり直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta continua sem proteção, e a senha que você digitou não foi salva nela. Aproxime a etiqueta do telefone novamente para tentar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签仍未受保护，你输入的密码也没有保存到标签上。请再次将标签贴近手机后重试。"
          }
        }
      }
    },
    "The tag is still unprotected, and this app could not confirm which password it now holds. Keep both the password you entered and the one it had before, then hold the tag against the phone again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال البطاقة غير محمية، وتعذّر على هذا التطبيق تأكيد كلمة المرور التي تحملها الآن. احتفظ بكلمة المرور التي أدخلتها وبالكلمة السابقة معًا، ثم قرّب البطاقة من الهاتف مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta sigue sin protección y esta app no ha podido confirmar qué contraseña tiene ahora. Guarda tanto la contraseña que has introducido como la que tenía antes, y luego acerca de nuevo la etiqueta al teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tag n'est toujours pas protégé et cette app n'a pas pu confirmer quel mot de passe il contient désormais. Conservez à la fois le mot de passe que vous avez saisi et le précédent, puis approchez à nouveau le tag du téléphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグは保護されていないままで、現在どのパスワードを保持しているかをこのアプリでは確認できませんでした。入力したパスワードと以前のパスワードの両方を控えたうえで、もう一度タグを端末にかざしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta continua sem proteção, e este app não conseguiu confirmar qual senha ela tem agora. Guarde tanto a senha que você digitou quanto a anterior e aproxime a etiqueta do telefone novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签仍未受保护，本应用也无法确认它现在持有哪个密码。请同时保留你输入的密码和它之前的密码，然后再次将标签贴近手机。"
          }
        }
      }
    },
    "The tag refused that password. This tag has an attempt limit set, so it may be locked out even if the password is right.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفضت البطاقة كلمة المرور هذه. هذه البطاقة مضبوطة بحد للمحاولات، لذا ربما تكون قد توقفت عن قبول كلمة المرور حتى لو كانت كلمة المرور صحيحة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta rechazó esa contraseña. Esta etiqueta tiene un límite de intentos configurado, así que puede estar bloqueada aunque la contraseña sea correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tag a refusé ce mot de passe. Une limite de tentatives est définie sur ce tag : il est donc peut-être bloqué, même si le mot de passe est correct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグがそのパスワードを拒否しました。このタグには試行回数の上限が設定されているため、パスワードが正しくても、すでに受け付けなくなっている可能性があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta recusou essa senha. Esta etiqueta tem limite de tentativas configurado, então ela pode estar bloqueada mesmo que a senha esteja correta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签拒绝了该密码。此标签设置了尝试次数上限，因此即使密码正确，它也可能已被锁死。"
          }
        }
      }
    },
    "The tag responded outside the expected protocol.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استجابت البطاقة خارج البروتوكول المتوقع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta respondió fuera del protocolo esperado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tag a répondu en dehors du protocole attendu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグが想定外のプロトコルで応答しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta respondeu fora do protocolo esperado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签的响应不符合预期协议。"
          }
        }
      }
    },
    "The tag responded with data this app could not parse.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استجابت البطاقة ببيانات لم يستطع هذا التطبيق تحليلها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta respondió con datos que esta app no pudo interpretar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tag a renvoyé des données que cette app n'a pas pu interpréter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグが、このアプリでは解析できないデータを返しました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta respondeu com dados que este app não conseguiu interpretar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签返回了本应用无法解析的数据。"
          }
        }
      }
    },
    "The tag stopped answering during a lock that cannot be undone, so this app cannot say whether any of its memory is now read-only. Treat this tag as one that may be locked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت البطاقة عن الاستجابة أثناء قفل لا يمكن التراجع عنه، لذا لا يستطيع هذا التطبيق تحديد ما إذا كان أي جزء من ذاكرتها قد صار للقراءة فقط. تعامل مع هذه البطاقة على أنها ربما تكون مقفلة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta dejó de responder durante un bloqueo que no se puede deshacer, así que esta app no puede decir si alguna parte de su memoria es ahora de solo lectura. Trata esta etiqueta como una que puede estar bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tag a cessé de répondre pendant un verrouillage irréversible : cette app ne peut donc pas dire si une partie de sa mémoire est désormais en lecture seule. Considérez ce tag comme peut-être verrouillé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せないロックの途中でタグが応答しなくなったため、メモリのいずれかが読み取り専用になったかどうかをこのアプリでは判断できません。このタグはロックされている可能性があるものとして扱ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta parou de responder durante um bloqueio que não pode ser desfeito, então este app não consegue dizer se alguma parte da memória agora é somente leitura. Trate esta etiqueta como possivelmente bloqueada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签在一次无法撤销的锁定过程中停止应答，因此本应用无法判断它是否已有内存变为只读。请把这枚标签当作可能已锁定来对待。"
          }
        }
      }
    },
    "The tag wrote back something different from what was sent. Try the write again.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعادت البطاقة محتوى مختلفًا عمّا أُرسل. أعد محاولة الكتابة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta devolvió algo distinto de lo que se envió. Vuelve a intentar la escritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tag a renvoyé un contenu différent de celui envoyé. Réessayez l'écriture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグの内容が送信したものと異なります。もう一度書き込んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta devolveu algo diferente do que foi enviado. Tente gravar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签回读的内容与写入的不一致。请重新写入。"
          }
        }
      }
    },
    "There isn't enough free memory on this card for an NDEF file. Nothing was written.": {
      "comment": "DESFire Format error.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر على هذه البطاقة ذاكرة حرة كافية لملف NDEF. لم تتم أي كتابة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente memoria libre en esta tarjeta para un archivo NDEF. No se escribió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette carte n'a pas assez de mémoire libre pour un fichier NDEF. Rien n'a été écrit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードには NDEF ファイルに必要な空きメモリがありません。何も書き込んでいません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há memória livre suficiente neste cartão para um arquivo NDEF. Nada foi gravado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡片的可用内存不足以容纳 NDEF 文件。未写入任何内容。"
          }
        }
      }
    },
    "There isn't enough free memory on this card for an NDEF file. Use Remove NDEF setup to clear what was started.": {
      "comment": "DESFire Format error. Names the Remove NDEF setup operation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر على هذه البطاقة ذاكرة حرة كافية لملف NDEF. استخدم «إزالة إعداد NDEF» لإزالة ما بدأ إعداده."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente memoria libre en esta tarjeta para un archivo NDEF. Usa Quitar configuración NDEF para borrar lo que se empezó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette carte n'a pas assez de mémoire libre pour un fichier NDEF. Utilisez Retirer la configuration NDEF pour effacer ce qui a été commencé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードには NDEF ファイルに必要な空きメモリがありません。途中まで作成したものは「NDEF 設定を削除」で消してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há memória livre suficiente neste cartão para um arquivo NDEF. Use Remover configuração NDEF para limpar o que foi iniciado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡片的可用内存不足以容纳 NDEF 文件。请使用「移除 NDEF 设置」清除已开始的设置。"
          }
        }
      }
    },
    "These details stay on your device, are used only for this read, and are never stored or sent anywhere.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى هذه البيانات على جهازك، وتُستخدم لهذه القراءة فقط، ولا تُحفظ أو تُرسل إلى أي مكان."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos datos permanecen en tu dispositivo, se usan solo para esta lectura y nunca se guardan ni se envían a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces informations restent sur votre appareil, ne servent qu'à cette lecture, et ne sont jamais enregistrées ni envoyées où que ce soit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した情報はデバイス内にとどまり、この読み取りにのみ使われます。保存も送信もされません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses dados ficam no seu dispositivo, são usados apenas nesta leitura e nunca são salvos nem enviados a lugar algum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些信息保留在你的设备上,仅用于本次读取,绝不会被保存或发送到任何地方。"
          }
        }
      }
    },
    "These records are too large for this tag.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه السجلات أكبر من سعة هذه البطاقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos registros son demasiado grandes para esta etiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces enregistrements sont trop volumineux pour ce tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのレコードはこのタグには大きすぎます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes registros são grandes demais para esta etiqueta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些记录对此标签来说太大了。"
          }
        }
      }
    },
    "This build isn't authorised for that tag type yet.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة غير مصرّح لها بعد بهذا النوع من البطاقات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación aún no está autorizada para ese tipo de etiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version n'est pas encore autorisée pour ce type de tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドはまだそのタグ種別に対応していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
