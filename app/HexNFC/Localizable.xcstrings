    "Disable NFC counter (NTAG213), replaces all of CFG1": {
      "comment": "Advanced console preset name. Keep chip, register and command names (NTAG213, CFG1, TT_CONFIG, AUTH0, PWD_AUTH, AFI, DSFID, NDEF, CC) as they are, and keep any warning the name carries, such as what it replaces or that it ends the read.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطيل عدّاد NFC (NTAG213)، يستبدل CFG1 بالكامل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar el contador NFC (NTAG213), reemplaza CFG1 por completo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver le compteur NFC (NTAG213), remplace CFG1 en entier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC カウンターを無効化(NTAG213)、CFG1 全体を置き換え"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar o contador NFC (NTAG213), substitui todo o CFG1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停用 NFC 计数器(NTAG213)，替换整个 CFG1"
          }
        }
      }
    },
