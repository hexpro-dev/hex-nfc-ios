        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms de station sont affichés lorsqu'ils sont connus ; les autres arrêts apparaissent sous forme de codes bruts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅名は判明しているものを表示します。それ以外の停留所は交通コードのまま表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes das estações são exibidos quando disponíveis; as demais paradas aparecem como seus códigos brutos de transporte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已知的站名会直接显示;其他站点则显示为原始交通代码。"
          }
        }
      }
    },
