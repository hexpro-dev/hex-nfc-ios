    "Some of these stops aren't named yet. You've been to them. Help fill in the blanks below.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض هذه المحطات بلا أسماء بعد. أنت زرتها، فساعدنا في ملء الفراغات أدناه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas de estas paradas aún no tienen nombre. Tú has estado en ellas: ayúdanos a completarlas abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains de ces arrêts n'ont pas encore de nom. Vous y êtes passé : aidez-nous à compléter ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前が未登録の停留所があります。実際に利用されたあなたなら分かるはずです。下から補完にご協力ください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas dessas paradas ainda não têm nome. Você esteve nelas: ajude a preencher abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一些站点还没有名称。你去过它们,欢迎在下方帮忙补全。"
          }
        }
      }
    },
