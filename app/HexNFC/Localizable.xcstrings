    "Start 3DES authenticate, leaves the handshake open": {
      "comment": "Advanced console preset name. Keep chip, register and command names (NTAG213, CFG1, TT_CONFIG, AUTH0, PWD_AUTH, AFI, DSFID, NDEF, CC) as they are, and keep any warning the name carries, such as what it replaces or that it ends the read.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدء مصادقة 3DES (تبقى المصافحة مفتوحة)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar la autenticación 3DES (deja el intercambio abierto)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer l'authentification 3DES (laisse l'échange ouvert)"
