    "Hold card to remove its NDEF setup.": {
      "comment": "Shown on the iOS NFC sheet during Remove NDEF setup.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب البطاقة لإزالة إعداد NDEF منها."
