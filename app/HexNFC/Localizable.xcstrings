    "Double-tap to edit. Swipe left to delete. Drag to reorder.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر مرتين للتحرير. اسحب لليسار للحذف. اسحب لإعادة الترتيب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para editar. Desliza a la izquierda para eliminar. Arrastra para reordenar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour modifier. Balayez vers la gauche pour supprimer. Faites glisser pour réordonner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップで編集、左スワイプで削除、ドラッグで並べ替えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para editar. Deslize para a esquerda para excluir. Arraste para reordenar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下编辑,向左轻扫删除,拖动可重新排序。"
          }
        }
      }
    },
