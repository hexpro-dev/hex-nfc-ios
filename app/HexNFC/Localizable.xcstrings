      }
    },
    "Format it from Operations to give it an NDEF application, then write records to it.": {
      "comment": "Scan result detail for a blank DESFire card. Names the Operations screen.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هيّئها من قائمة العمليات لتحصل على تطبيق NDEF، ثم اكتب السجلات عليها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatéala desde Operaciones para darle una aplicación NDEF y luego escribe registros en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatez-la depuis Opérations pour lui donner une application NDEF, puis écrivez-y des enregistrements."
          }
        },
        "ja": {
