        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar a autenticação 3DES (deixa o handshake aberto)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
