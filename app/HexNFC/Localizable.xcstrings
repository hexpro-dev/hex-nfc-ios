    "We want this to be the best app possible. If something's not right, we want to fix it.": {
      "comment": "On the 'Loving Hex NFC?' card that occasionally rises from the foot of the home screen. Shown after the user answers 'Meh.', above a Send Feedback button.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نريد أن يكون هذا أفضل تطبيق ممكن. إن كان هناك شيء ليس على ما يرام، فنحن نريد إصلاحه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queremos que sea la mejor app posible. Si algo no va bien, queremos arreglarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous voulons que cette app soit la meilleure possible. Si quelque chose ne va pas, nous voulons le corriger."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最高のアプリにしたいと考えています。うまくいかないことがあれば、ぜひ直させてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Queremos que este seja o melhor app possível. Se algo não estiver certo, queremos corrigir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们希望把它做成最好的应用。如果有哪里不对劲，我们想把它修好。"
          }
        }
      }
    },
    "Websites": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
