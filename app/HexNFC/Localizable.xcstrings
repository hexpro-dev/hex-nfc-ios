    "Could not parse command.": {
      "comment": "Advanced console error shown when the typed raw command cannot be read as a command sequence.",
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحليل الأمر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo interpretar el comando."
          }
        },
        "fr": {
          "stringUnit": {
