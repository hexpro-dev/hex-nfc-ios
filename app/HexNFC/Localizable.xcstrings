    "This tag is password protected, so it cannot be permanently locked. Remove the password first, then lock it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه البطاقة محمية بكلمة مرور، لذا لا يمكن قفلها نهائيًا. أزل كلمة المرور أولاً، ثم اقفلها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta está protegida con contraseña, así que no se puede bloquear permanentemente. Quita primero la contraseña y luego bloquéala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tag est protégé par mot de passe : il ne peut donc pas être verrouillé définitivement. Retirez d'abord le mot de passe, puis verrouillez-le."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグはパスワードで保護されているため、完全にロックできません。先にパスワードを削除してから、ロックしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta está protegida por senha, então não pode ser bloqueada permanentemente. Remova a senha primeiro e depois bloqueie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签受密码保护，因此无法永久锁定。请先移除密码，再进行锁定。"
          }
        }
      }
    },
    "This tag is password-protected. Enter its password to write to it, then hold it to the top of your iPhone again.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه البطاقة محمية بكلمة مرور. أدخل كلمة المرور للكتابة عليها، ثم ضعها مجددًا بالقرب من أعلى iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta está protegida con contraseña. Introduce su contraseña para escribir en ella y vuelve a acercarla a la parte superior del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tag est protégé par mot de passe. Saisissez son mot de passe pour y écrire, puis présentez-le à nouveau contre le haut de l'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグはパスワードで保護されています。書き込むにはパスワードを入力し、もう一度 iPhone の上部にかざしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta está protegida por senha. Digite a senha para gravar nela e encoste-a novamente na parte superior do iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签受密码保护。请输入其密码以写入,然后再次将其贴近 iPhone 顶部。"
          }
        }
      }
    },
    "This tag is permanently locked. Writes are no longer possible.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه البطاقة مقفلة نهائيًا، ولم تعد الكتابة ممكنة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta está bloqueada permanentemente. Ya no se puede escribir en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tag est verrouillé définitivement. L'écriture n'est plus possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグは完全にロックされています。書き込みはできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
