        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca la tarjeta para quitarle la configuración NDEF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez la carte pour retirer sa configuration NDEF."
