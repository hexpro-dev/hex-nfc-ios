    "This tag looks key-protected. Enter its 16-byte 3DES key, then hold it to the top of your iPhone again.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن هذه البطاقة محمية بمفتاح. أدخل مفتاح 3DES بطول 16 بايت، ثم ضعها مجددًا بالقرب من أعلى iPhone."
          }
