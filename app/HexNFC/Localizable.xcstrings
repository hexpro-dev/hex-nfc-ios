    "Enter a latitude and a longitude, or a map URL. Until then, this record cannot be written to a tag.": {
      "comment": "Note on the Location record form, shown while the record has neither both coordinates nor a map URL.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل خط العرض وخط الطول، أو رابط الخريطة. وإلى أن تفعل، لا يمكن كتابة هذا السجل على بطاقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una latitud y una longitud, o una URL del mapa. Hasta entonces, este registro no se puede escribir en una etiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une latitude et une longitude, ou une URL de carte. D'ici là, cet enregistrement ne peut pas être écrit sur un tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緯度と経度、または地図の URL を入力してください。入力するまで、このレコードはタグに書き込めません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe uma latitude e uma longitude, ou uma URL do mapa. Até lá, este registro não pode ser gravado em uma etiqueta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入纬度和经度，或地图网址。在此之前，这条记录无法写入标签。"
          }
        }
      }
    },
