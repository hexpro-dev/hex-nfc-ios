    "No tag found, so nothing was sent. Hold the tag flat against the top of your iPhone and try again.": {
      "comment": "Advanced console log line. The NFC session timed out with no tag in the field, so no command frame went out.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على أي بطاقة، لذا لم يُرسَل أي شيء. ضع البطاقة مسطّحة على أعلى الـ iPhone وحاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna etiqueta, así que no se envió nada. Apoya la etiqueta plana contra la parte superior del iPhone e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun tag trouvé, donc rien n'a été envoyé. Posez le tag à plat contre le haut de l'iPhone et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグが見つからなかったため、何も送信していません。タグを iPhone の上部に平らに当てて、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma etiqueta encontrada, então nada foi enviado. Encoste a etiqueta plana na parte superior do iPhone e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到标签，因此未发送任何内容。请将标签平贴在 iPhone 顶部后重试。"
          }
        }
      }
    },
