    "Hold tag to identify.": {
      "comment": "Shown on the iOS NFC sheet while the Advanced console identifies a tag.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب البطاقة للتعرّف عليها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca la etiqueta para identificarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez le tag pour l'identifier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグをかざして識別します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime a etiqueta para identificá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴近标签以识别。"
          }
        }
      }
    },
    "Hold tag to lock.": {
      "comment": "Shown on the iOS NFC sheet during the Permanent lock operation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب البطاقة لقفلها."
