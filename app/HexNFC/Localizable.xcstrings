    "Station names are shown where available; other stops appear as their raw transit codes.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض أسماء المحطات عند توفرها، وتظهر بقية المحطات برموز النقل الخام."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran los nombres de estación cuando están disponibles; el resto de paradas aparecen con sus códigos de transporte en crudo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms de station sont affichés lorsqu'ils sont connus ; les autres arrêts apparaissent sous forme de codes bruts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅名は判明しているものを表示します。それ以外の停留所は交通コードのまま表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes das estações são exibidos quando disponíveis; as demais paradas aparecem como seus códigos brutos de transporte."
