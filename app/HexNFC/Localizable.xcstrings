    "Couldn't reach Hex Pro. Check your connection and try again.": {
      "comment": "Feedback form. Shown when the message could not be sent: offline, timed out, or the service is down.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى Hex Pro. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar con Hex Pro. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Hex Pro. Vérifiez votre connexion et réessayez."
