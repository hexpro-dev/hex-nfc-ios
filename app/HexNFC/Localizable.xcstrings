    "%@ can read this pen and log your doses.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستطيع %@ قراءة هذا القلم وتسجيل جرعاتك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ puede leer esta pluma y registrar tus dosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut lire ce stylo et consigner vos doses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ならこのペンを読み取り、投与量を記録できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ consegue ler esta caneta e registrar suas doses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可以读取这支笔并记录你的注射剂量。"
          }
        }
      }
    },
