    "Console idle. Tap a preset on the left, or type a sequence and Run.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وحدة التحكم خاملة. المس قالبًا على اليسار، أو اكتب تسلسلًا ثم شغّله."
          }
        },
        "es": {
          "stringUnit": {
