    "It has no Capability Container, so records written now won't be readable. Format it first.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي على Capability Container، لذا لن تكون السجلات المكتوبة الآن قابلة للقراءة. هيّئها أولًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene Capability Container, así que los registros que escribas ahora no serán legibles. Formatéala primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'a pas de Capability Container : les enregistrements écrits maintenant ne seront pas lisibles. Formatez-le d'abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capability Container がないため、いま書き込んだレコードは読めません。先にフォーマットしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela não tem Capability Container, então os registros gravados agora não serão legíveis. Formate-a primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它没有 Capability Container,现在写入的记录将无法读取。请先格式化。"
          }
        }
      }
    },
    "It has no NDEF application yet, so records can't be written to it. Format it to set one up.": {
      "comment": "Editor notice detail for a blank DESFire card. Tapping it opens Operations.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحمل تطبيق NDEF بعد، لذا لا يمكن كتابة سجلات عليها. هيّئها لإعداد واحد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no tiene una aplicación NDEF, así que no se le pueden escribir registros. Formatéala para crear una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle n'a pas encore d'application NDEF, on ne peut donc pas y écrire d'enregistrements. Formatez-la pour en créer une."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ NDEF アプリケーションがないため、レコードを書き込めません。フォーマットして作成してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele ainda não tem uma aplicação NDEF, então não é possível gravar registros nele. Formate-o para criar uma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它还没有 NDEF 应用，因此无法写入记录。请格式化以创建一个。"
          }
        }
      }
    },
