    "Hold tag to remove the password.": {
      "comment": "Shown on the iOS NFC sheet during the Remove password operation.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب البطاقة لإزالة كلمة المرور."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca la etiqueta para quitar la contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez le tag pour retirer le mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグをかざしてパスワードを削除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime a etiqueta para remover a senha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴近标签以移除密码。"
          }
        }
