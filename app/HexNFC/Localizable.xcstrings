    "You'll hold the tag twice: once so we can read its ID, then again to make the change.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستضع البطاقة مرتين: مرة لقراءة معرّفها، ثم مرة لتنفيذ التغيير."
          }
        },
        "es": {
