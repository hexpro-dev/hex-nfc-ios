    "Records and formatting can no longer be written.": {
      "comment": "Editor Protection row detail under \"Permanently locked\", for a tag with no password, or one whose password is a key this app removes from the Protection card rather than from Operations.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد بالإمكان كتابة السجلات أو التهيئة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no se pueden escribir registros ni formatear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements et le formatage ne peuvent plus être écrits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レコードの書き込みとフォーマットはできなくなりました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é mais possível gravar registros nem formatar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能再写入记录或格式化。"
          }
        }
      }
    },
    "Records and formatting can no longer be written. A password can still be removed under Operations.": {
      "comment": "Editor Protection row detail under \"Permanently locked\". A permanent lock sets lock and block-lock bits only, so the password block stays writable and Operations can still remove a password.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد بالإمكان كتابة السجلات أو التهيئة. ولا يزال بالإمكان إزالة كلمة المرور من قسم العمليات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no se pueden escribir registros ni formatear. La contraseña todavía se puede quitar desde Operaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements et le formatage ne peuvent plus être écrits. Un mot de passe peut encore être supprimé depuis Opérations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レコードの書き込みとフォーマットはできなくなりました。パスワードは「操作」から削除できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é mais possível gravar registros nem formatar. A senha ainda pode ser removida em Operações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能再写入记录或格式化。仍可在“操作”中移除密码。"
          }
        }
      }
    },
    "Reduce Motion": {
      "extractionState": "stale",
