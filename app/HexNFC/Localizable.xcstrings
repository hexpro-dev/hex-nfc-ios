    "Stored as a file:// URL. iOS limits the directories this can target.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزَّن كرابط ‎file://‎. يحدّ iOS من الأدلة التي يمكن أن يشير إليها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda como URL file://. iOS limita los directorios a los que puede apuntar."
          }
