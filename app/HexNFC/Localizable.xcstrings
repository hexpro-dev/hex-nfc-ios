    },
    "This tag is permanently locked. Writes are no longer possible.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه البطاقة مقفلة نهائيًا، ولم تعد الكتابة ممكنة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
