    "Require a 4-byte password to write to this tag (ICODE SLIX). Applied as part of the next write.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب كلمة مرور بطول 4 بايت للكتابة على هذه البطاقة (ICODE SLIX). تُطبَّق مع الكتابة التالية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige una contraseña de 4 bytes para escribir en esta etiqueta (ICODE SLIX). Se aplica en la próxima escritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige un mot de passe de 4 octets pour écrire sur ce tag (ICODE SLIX). Appliqué lors de la prochaine écriture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグ(ICODE SLIX)への書き込みに 4 バイトのパスワードを要求します。次回の書き込み時に適用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige uma senha de 4 bytes para gravar nesta etiqueta (ICODE SLIX). Aplicada na próxima gravação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入此标签(ICODE SLIX)时需要 4 字节密码。将在下次写入时应用。"
          }
        }
      }
    },
    "Require a 4-byte password to write to this tag. Apply it as part of the next write: and reuse it across many tags by saving it with a preset.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب كلمة مرور بطول 4 بايت للكتابة على هذه البطاقة. تُطبَّق مع الكتابة التالية، ويمكن إعادة استخدامها على بطاقات كثيرة بحفظها ضمن قالب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige una contraseña de 4 bytes para escribir en esta etiqueta. Se aplica en la próxima escritura, y puedes reutilizarla en muchas etiquetas guardándola con un preajuste."
          }
        },
        "fr": {
          "stringUnit": {
