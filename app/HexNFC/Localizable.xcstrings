    "Enter the details printed on your passport's photo page, then hold it to the top of your iPhone again.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل البيانات المطبوعة في صفحة الصورة من جواز سفرك، ثم ضعه مجددًا بالقرب من أعلى iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce los datos impresos en la página de la fotografía de tu pasaporte y vuelve a acercarlo a la parte superior del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez les informations imprimées sur la page photo de votre passeport, puis présentez-le à nouveau contre le haut de l'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスポートの写真ページに印字されている情報を入力し、もう一度 iPhone の上部にかざしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite os dados impressos na página com a foto do seu passaporte e encoste-o novamente na parte superior do iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入护照照片页上印刷的信息,然后再次将其贴近 iPhone 顶部。"
          }
        }
      }
    },
