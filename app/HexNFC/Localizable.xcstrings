    "Format it from Operations before writing, or nothing you write will be readable.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هيّئها من قائمة العمليات قبل الكتابة، وإلا فلن يكون أي شيء تكتبه قابلًا للقراءة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatéala desde Operaciones antes de escribir, o nada de lo que escribas será legible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatez-le depuis Opérations avant d'écrire, sinon rien de ce que vous écrirez ne sera lisible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込む前に「操作」からフォーマットしてください。そうしないと書き込んだ内容は読めません。"
          }
        },
        "pt-BR": {
