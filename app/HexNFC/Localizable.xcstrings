    "This tag has no attempt limit set.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد حد للمحاولات مضبوط على هذه البطاقة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
