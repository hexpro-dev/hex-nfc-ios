    "Probe the key range at 2Ch, NAKs and ends the tap": {
      "comment": "Advanced console preset name. Keep chip, register and command names (NTAG213, CFG1, TT_CONFIG, AUTH0, PWD_AUTH, AFI, DSFID, NDEF, CC) as they are, and keep any warning the name carries, such as what it replaces or that it ends the read.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فحص نطاق المفتاح عند 2Ch (تردّ البطاقة بـ NAK وتنتهي اللمسة الحالية)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sondear el rango de la clave en 2Ch (responde NAK y termina esta lectura)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonder la plage de clé en 2Ch (renvoie un NAK et met fin à ce passage)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2Ch の鍵領域をプローブ(NAK が返り、今回のタップは終了)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sondar a faixa da chave em 2Ch (responde NAK e encerra esta leitura)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探测 2Ch 处的密钥区域(返回 NAK，本次贴合随之结束)"
          }
        }
      }
    },
