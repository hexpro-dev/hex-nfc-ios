    "You'll hold the tag twice: once so we can read its ID, then again to make the change.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستضع البطاقة مرتين: مرة لقراءة معرّفها، ثم مرة لتنفيذ التغيير."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercarás la etiqueta dos veces: una para leer su ID y otra para aplicar el cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous présenterez le tag deux fois : une première pour lire son ID, une seconde pour appliquer le changement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグを 2 回かざします。1 回目で ID を読み取り、2 回目で変更を適用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai encostar a etiqueta duas vezes: uma para ler o ID e outra para aplicar a mudança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你需要贴两次标签:第一次读取其 ID,第二次执行更改。"
          }
        }
      }
    },
    "You've removed every record. Write to clear the tag, or add one back.": {
      "extractionState": "stale",
      "localizations": {
