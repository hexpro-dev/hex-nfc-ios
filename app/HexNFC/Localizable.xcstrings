            "value": "Approchez le tag pour définir la limite de tentatives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグをかざして試行回数の上限を設定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
