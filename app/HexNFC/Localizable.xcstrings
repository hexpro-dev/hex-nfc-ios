          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该密码未能解锁标签。请检查后重试。"
          }
        }
      }
    },
    "That's a different tag.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه بطاقة مختلفة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa es otra etiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas le même tag."
          }
        },
        "ja": {
