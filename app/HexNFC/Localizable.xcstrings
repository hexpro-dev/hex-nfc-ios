    "Read from the chip and shown here for this session only: not saved, not sent, and not verified for authenticity.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُرِئت من الشريحة وتُعرض هنا لهذه الجلسة فقط: لا تُحفظ ولا تُرسل ولا يُتحقق من صحتها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leído del chip y mostrado aquí solo durante esta sesión: no se guarda, no se envía y no se verifica su autenticidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu depuis la puce et affiché ici pour cette session uniquement : rien n'est enregistré, rien n'est envoyé, et l'authenticité n'est pas vérifiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チップから読み取り、このセッションでのみ表示しています。保存も送信もせず、真正性の検証も行いません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lido do chip e exibido aqui apenas nesta sessão: nada é salvo, nada é enviado e a autenticidade não é verificada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从芯片读取,仅在本次会话中显示:不保存、不发送,也不验证真伪。"
          }
        }
      }
    },
    "Read passport": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
