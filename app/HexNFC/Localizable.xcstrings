    "Still looking. Tilt the page away from bright lights, or try the torch.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زال البحث جاريًا. أمِل الصفحة بعيدًا عن الأضواء الساطعة، أو جرّب المصباح."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimos buscando. Inclina la página para apartarla de las luces intensas o prueba la linterna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche en cours. Inclinez la page pour éviter les lumières vives, ou essayez la lampe torche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ探しています。強い光が当たらないようにページを傾けるか、ライトを試してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda procurando. Incline a página para longe de luzes fortes ou experimente a lanterna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在查找。请倾斜页面避开强光，或试试手电筒。"
          }
        }
      }
    },
