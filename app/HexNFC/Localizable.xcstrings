    "What's not right, or what could be better?": {
      "comment": "Feedback form. Placeholder in the empty message box.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي لا يعمل كما ينبغي، أو ما الذي يمكن تحسينه؟"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué no va bien o qué podría mejorar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui ne va pas, ou que pourrait-on améliorer ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいかないことや、改善してほしいことを教えてください"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que não está certo ou o que poderia melhorar?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪里不对劲，或者哪里可以做得更好？"
          }
        }
      }
    },
