    "Gate this tag behind a 16-byte 3DES key (MIFARE Ultralight C). Applied as part of the next write; reuse it across tags by saving it with a preset.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمي هذه البطاقة بمفتاح 3DES بطول 16 بايت (MIFARE Ultralight C). يُطبَّق مع الكتابة التالية، ويمكن إعادة استخدامه على بطاقات أخرى بحفظه ضمن قالب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege esta etiqueta tras una clave 3DES de 16 bytes (MIFARE Ultralight C). Se aplica en la próxima escritura; reutilízala en varias etiquetas guardándola con un preajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protège ce tag derrière une clé 3DES de 16 octets (MIFARE Ultralight C). Appliquée lors de la prochaine écriture ; réutilisez-la sur plusieurs tags en l'enregistrant avec un préréglage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグを 16 バイトの 3DES 鍵(MIFARE Ultralight C)で保護します。次回の書き込み時に適用されます。プリセットに保存すれば複数のタグで使い回せます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege esta etiqueta com uma chave 3DES de 16 bytes (MIFARE Ultralight C). Aplicada na próxima gravação; reutilize-a em várias etiquetas salvando-a com um preajuste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 16 字节 3DES 密钥(MIFARE Ultralight C)保护此标签。将在下次写入时应用;将其随预设保存即可用于多个标签。"
          }
        }
      }
    },
