            "value": "iOS 版本"
          }
        }
      }
    },
    "iPhone will not auto-connect from NFC, but Android readers will. Hex NFC writes the record to spec so any reader can pick it up.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتصل iPhone تلقائيًا عبر NFC، لكن قارئات أندرويد ستفعل. يكتب Hex NFC السجل وفقًا للمواصفات حتى يتمكن أي قارئ من قراءته."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone no se conecta automáticamente por NFC; los lectores Android sí. Hex NFC escribe el registro según el estándar para que cualquier lector lo lea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ne se connectera pas automatiquement via NFC, mais les lecteurs Android le feront. Hex NFC écrit l'enregistrement conformément à la spécification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone は NFC から自動接続しませんが、Android のリーダーは接続します。Hex NFC は仕様通りにレコードを書き込みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone não se conecta automaticamente via NFC, mas leitores Android sim. Hex NFC grava o registro conforme a especificação para qualquer leitor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 不会通过 NFC 自动连接,但 Android 读取设备可以。Hex NFC 按规范写入记录,任何读取设备都能识别。"
          }
        }
      }
    },
