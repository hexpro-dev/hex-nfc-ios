    "This works only on MIFARE DESFire EV1, EV2 and EV3 cards.": {
      "comment": "Format or Remove NDEF setup on a DESFire generation the app does not set up. Product names stay in Latin script.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل هذا فقط مع بطاقات MIFARE DESFire EV1 وEV2 وEV3."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo funciona con tarjetas MIFARE DESFire EV1, EV2 y EV3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne fonctionne qu'avec les cartes MIFARE DESFire EV1, EV2 et EV3."
          }
        },
        "ja": {
          "stringUnit": {
