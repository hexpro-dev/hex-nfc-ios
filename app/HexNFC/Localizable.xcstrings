    },
    "This tag has no password set, so there is nothing for an attempt limit to guard.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد كلمة مرور مضبوطة على هذه البطاقة، لذا ليس هناك ما يحميه حد المحاولات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta no tiene contraseña, así que no hay nada que un límite de intentos pueda proteger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tag n'a pas de mot de passe : une limite de tentatives n'y protégerait rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグにはパスワードが設定されていないため、試行回数の上限が守るものがありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta não tem senha definida, então não há nada que um limite de tentativas possa proteger."
          }
        },
        "zh-Hans": {
