    "This tag is key-protected. Enter its 16-byte 3DES key to write to it, then hold it to the top of your iPhone again.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه البطاقة محمية بمفتاح. أدخل مفتاح 3DES بطول 16 بايت للكتابة عليها، ثم ضعها مجددًا بالقرب من أعلى iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta está protegida con clave. Introduce su clave 3DES de 16 bytes para escribir en ella y vuelve a acercarla a la parte superior del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tag est protégé par une clé. Saisissez sa clé 3DES de 16 octets pour y écrire, puis présentez-le à nouveau contre le haut de l'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグは鍵で保護されています。書き込むには 16 バイトの 3DES 鍵を入力し、もう一度 iPhone の上部にかざしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta está protegida por chave. Digite a chave 3DES de 16 bytes para gravar nela e encoste-a novamente na parte superior do iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签受密钥保护。请输入其 16 字节 3DES 密钥以写入,然后再次将其贴近 iPhone 顶部。"
          }
        }
      }
    },
