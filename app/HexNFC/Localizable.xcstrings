    "It has no Capability Container, so records written now won't be readable. Format it first.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي على Capability Container، لذا لن تكون السجلات المكتوبة الآن قابلة للقراءة. هيّئها أولًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene Capability Container, así que los registros que escribas ahora no serán legibles. Formatéala primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'a pas de Capability Container : les enregistrements écrits maintenant ne seront pas lisibles. Formatez-le d'abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capability Container がないため、いま書き込んだレコードは読めません。先にフォーマットしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela não tem Capability Container, então os registros gravados agora não serão legíveis. Formate-a primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它没有 Capability Container,现在写入的记录将无法读取。请先格式化。"
          }
        }
      }
    },
