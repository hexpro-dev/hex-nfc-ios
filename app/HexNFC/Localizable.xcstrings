    "Override the system Reduce Motion preference for this app.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز إعداد النظام «تقليل الحركة» لهذا التطبيق."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula la preferencia del sistema «Reducir movimiento» para esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outrepasse le réglage système « Réduire les animations » pour cette app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリではシステムの「視差効果を減らす」設定を上書きします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui a preferência do sistema «Reduzir movimento» para este app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此应用覆盖系统的「减弱动态效果」设置。"
          }
        }
      }
    },
    "Overwrite the NDEF area with an empty message. Records are gone, the chip stays writable, and a data area that won't read is rebuilt.": {
      "comment": "Erase operation intro. Replaces the shorter version, which mentioned only records and left the repair it also performs unsaid.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل منطقة NDEF برسالة فارغة. تُحذف السجلات، وتبقى الشريحة قابلة للكتابة، وتُعاد كتابة منطقة بيانات غير قابلة للقراءة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescribe el área NDEF con un mensaje vacío. Los registros desaparecen, el chip sigue siendo escribible y se reconstruye un área de datos ilegible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace la zone NDEF par un message vide. Les enregistrements disparaissent, la puce reste inscriptible, et une zone de données illisible est reconstruite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NDEF 領域を空のメッセージで上書きします。レコードは消え、チップは書き込み可能なままで、読み取れないデータ領域は作り直されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescreve a área NDEF com uma mensagem vazia. Os registros somem, o chip continua gravável e uma área de dados que não é lida é reconstruída."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用空消息覆盖 NDEF 区域。记录会消失，芯片仍可写入，无法读取的数据区会被重建。"
          }
        }
      }
    },
    "Overwrite the NDEF area with an empty message. Records are gone; the chip remains writable.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل منطقة NDEF برسالة فارغة. تُحذف السجلات وتبقى الشريحة قابلة للكتابة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescribe el área NDEF con un mensaje vacío. Los registros desaparecen; el chip sigue siendo escribible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace la zone NDEF par un message vide. Les enregistrements disparaissent ; la puce reste inscriptible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NDEF 領域を空のメッセージで上書きします。レコードは消えますが、チップは書き込み可能なままです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrescreve a área NDEF com uma mensagem vazia. Os registros somem; o chip continua gravável."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用空消息覆盖 NDEF 区域。记录会消失,芯片仍可写入。"
          }
        }
      }
    },
