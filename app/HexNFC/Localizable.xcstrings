    },
    "Hold tag to set the attempt limit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب البطاقة لضبط حد المحاولات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca la etiqueta para establecer el límite de intentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez le tag pour définir la limite de tentatives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグをかざして試行回数の上限を設定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime a etiqueta para definir o limite de tentativas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴近标签以设置尝试次数上限。"
          }
        }
      }
    },
    "Hold the tag against the top of your iPhone.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع البطاقة بالقرب من أعلى iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la etiqueta en la parte superior del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez le tag contre le haut de l'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone の上部にタグを当ててください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a etiqueta na parte superior do iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标签贴在 iPhone 顶部。"
          }
        }
      }
    },
    "Hold the tag against your iPhone again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب البطاقة من iPhone مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de nuevo la etiqueta al iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez à nouveau le tag de l'iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度タグを iPhone にかざしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime a etiqueta do iPhone novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请再次将标签贴近 iPhone。"
          }
        }
      }
    },
    "Hold the tag flat against the top of your iPhone, then try again.": {
      "comment": "The one hint under \"No tag found\". The session timed out with nothing in the field.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع البطاقة مسطّحة على أعلى الـ iPhone، ثم حاول مجددًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya la etiqueta plana contra la parte superior del iPhone e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez le tag à plat contre le haut de l'iPhone, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグを iPhone の上部に平らに当ててから、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encoste a etiqueta plana na parte superior do iPhone e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标签平贴在 iPhone 顶部，然后重试。"
          }
        }
      }
    },
