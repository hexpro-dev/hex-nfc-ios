    "Burn the static and dynamic lock bytes. Writes will fail forever after this completes. There is no undo.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحرق بايتات القفل الثابتة والديناميكية. بعد اكتمال العملية ستفشل الكتابة إلى الأبد، ولا يمكن التراجع."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba los bytes de bloqueo estáticos y dinámicos. Tras completarse, cualquier escritura fallará para siempre. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave les octets de verrouillage statiques et dynamiques. Toute écriture échouera définitivement une fois l'opération terminée. Il n'y a pas de retour en arrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタティックおよびダイナミックロックバイトを書き込みます。完了後は書き込みが永久に失敗します。取り消しはできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava os bytes de bloqueio estáticos e dinâmicos. Depois disso, qualquer gravação falhará para sempre. Não há como desfazer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烧录静态和动态锁定字节。完成后写入将永远失败。无法撤销。"
          }
        }
      }
    },
