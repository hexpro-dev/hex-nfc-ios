          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签已永久锁定,无法再写入。"
          }
        }
      }
    },
    "This tag is read-protected, so the limit it holds now can't be read until its password is presented.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه البطاقة محمية من القراءة، لذا لا يمكن قراءة الحد الحالي إلا بعد تقديم كلمة المرور."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta está protegida contra lectura, así que el límite que tiene ahora no se puede leer hasta presentar su contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tag est protégé en lecture : la limite qu'il contient ne peut pas être lue tant que son mot de passe n'a pas été présenté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグは読み取りが保護されているため、パスワードを提示するまで現在の上限を読み取れません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta está protegida contra leitura, então o limite atual não pode ser lido até que a senha seja apresentada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签受读取保护，在提交密码之前无法读取它当前的上限。"
          }
        }
      }
    },
    "This tag is still protected. Nothing has been lost: hold it against the phone again to finish removing the password.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال هذه البطاقة محمية. لم يُفقد شيء: قرّبها من الهاتف مرة أخرى لإكمال إزالة كلمة المرور."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta sigue protegida. No se ha perdido nada: acércala de nuevo al teléfono para terminar de quitar la contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tag est toujours protégé. Rien n'est perdu : approchez-le à nouveau du téléphone pour terminer la suppression du mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグはまだ保護されています。失われたものはありません。もう一度端末にかざして、パスワードの削除を完了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta ainda está protegida. Nada foi perdido: aproxime-a do telefone novamente para terminar de remover a senha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
