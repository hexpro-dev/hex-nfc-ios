{
	"catalogue": 1,
	"rigs": {
		"ntag213": {
			"chip": "NTAG213",
			"prepare": "text-record",
			"description": "A formatted, unprotected NTAG213 under the top of the phone. Its contents are overwritten with Text records, and any protection a shot adds is removed before the run moves on."
		},
		"no-tag": {
			"description": "Nothing under the phone: lift it off the tag. For the states an NFC sheet shows while it waits."
		},
		"system-reduce-motion": {
			"description": "No tag needed. Turn on iOS Settings > Accessibility > Motion > Reduce Motion first, and off again afterwards."
		},
		"ultralight-c": {
			"chip": "MIFARE Ultralight C",
			"description": "A MIFARE Ultralight C, read and configured but never locked."
		},
		"ultralight-ev1-blank": {
			"chip": "MIFARE Ultralight EV1",
			"description": "A MIFARE Ultralight EV1 that has never been formatted. The run only reads it, so it stays blank for the next language."
		},
		"mock": {
			"description": "No tag needed. The app runs on its simulated NFC session, for the one state none of the tags on hand can produce."
		},
		"ntag213-sacrificial": {
			"chip": "NTAG213",
			"requiresSacrificeUID": true,
			"description": "An NTAG213 that may be locked for good. It is locked the first time and only scanned after that, so one tag serves every language."
		},
		"ultralight-c-sacrificial": {
			"chip": "MIFARE Ultralight C",
			"requiresSacrificeUID": true,
			"description": "A MIFARE Ultralight C that will be locked for good. Its one shot is taken in English only, so one tag in all."
		},
		"desfire-ev3-throwaway": {
			"chip": "MIFARE DESFire",
			"requiresSacrificeUID": true,
			"description": "The throwaway MIFARE DESFire EV3, left set up for NDEF. The run removes the setup and formats the card again, so it ends set up as it began. Every shot changes the card, so every shot checks its UID against --sacrifice-uid. The Dangerous Actions grid needs no tag and rides along."
		}
	},
