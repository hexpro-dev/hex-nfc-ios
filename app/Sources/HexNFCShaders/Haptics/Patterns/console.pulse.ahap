        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 1.00 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.70 }
        ]
      }
    },
    {
      "Event": {
        "Time": 0.045,
        "EventType": "HapticTransient",
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.70 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.90 }
        ]
      }
    },
    {
      "Event": {
        "Time": 0.020,
        "EventType": "HapticContinuous",
        "EventDuration": 0.300,
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.45 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.55 }
        ]
      }
    },
    {
      "ParameterCurve": {
        "ParameterID": "HapticIntensityControl",
