{
  "Version": 1.0,
  "Metadata": {
    "Project": "Hex NFC",
    "Pattern": "copy.tick",
    "Description": "A crisp tap with a brief soft swell — a “lifted off the glass” confirmation that a value landed on the clipboard."
  },
  "Pattern": [
    {
      "Event": {
        "Time": 0.00,
        "EventType": "HapticTransient",
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.60 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.85 }
        ]
      }
    },
    {
      "Event": {
        "Time": 0.03,
        "EventType": "HapticContinuous",
        "EventDuration": 0.12,
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.22 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.50 }
        ]
      }
    },
    {
      "ParameterCurve": {
        "ParameterID": "HapticIntensityControl",
        "Time": 0.03,
        "ParameterCurveControlPoints": [
          { "Time": 0.00, "ParameterValue": 0.10 },
          { "Time": 0.12, "ParameterValue": -0.40 }
        ]
      }
    }
  ]
}
