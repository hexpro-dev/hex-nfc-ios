{
  "Version": 1.0,
  "Metadata": {
    "Project": "Hex NFC",
    "Pattern": "destructive.warn",
    "Description": "Three slow rising transients while the destructive-confirmation UID is being typed."
  },
  "Pattern": [
    {
      "Event": {
        "Time": 0.00,
        "EventType": "HapticTransient",
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.50 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.60 }
        ]
      }
    },
    {
      "Event": {
        "Time": 0.20,
        "EventType": "HapticTransient",
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.70 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.70 }
        ]
      }
    },
    {
      "Event": {
        "Time": 0.40,
        "EventType": "HapticTransient",
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.90 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.80 }
        ]
      }
    }
  ]
}
