{
  "Version": 1.0,
  "Metadata": {
    "Project": "Hex NFC",
    "Pattern": "mrz.lock",
    "Description": "Passport details locked in from the camera: a crisp click as the key snaps into place, a deeper detent 70 ms behind it, then a short settle that fades with the tick."
