{
  "Version": 1.0,
  "Metadata": {
    "Project": "Hex NFC",
    "Pattern": "ui.commit",
    "Description": "A weighty tap with a short low swell behind it — the meaty landing of a committed hard action (save, add record, load preset)."
  },
  "Pattern": [
    {
      "Event": {
        "Time": 0.00,
        "EventType": "HapticTransient",
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.85 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.55 }
        ]
      }
    },
    {
      "Event": {
        "Time": 0.02,
        "EventType": "HapticContinuous",
        "EventDuration": 0.14,
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.35 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.45 }
        ]
      }
    },
    {
      "ParameterCurve": {
        "ParameterID": "HapticIntensityControl",
        "Time": 0.02,
        "ParameterCurveControlPoints": [
          { "Time": 0.00, "ParameterValue": 0.10 },
          { "Time": 0.14, "ParameterValue": -0.45 }
        ]
      }
    }
  ]
}
