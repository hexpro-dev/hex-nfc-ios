			"term": "NDEF",
			"note": "The data format an NFC tag carries. It is printed on packaging and typed into a search box, so it stays in Latin letters in every locale."
		},
		{
			"kind": "do-not-translate",
			"term": "NTAG213",
			"note": "A part number. It is printed on the chip and typed into a search box."
		},
