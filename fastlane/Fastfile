# Hex NFC release automation.
#
# Everything authenticates with an App Store Connect API key, so no lane needs
# an Apple ID, a password, a session cookie, or a 2FA prompt. The key is
# supplied as three environment variables and never written to the repo:
#
#   ASC_API_KEY_ID         the key's ten character id
#   ASC_API_KEY_ISSUER_ID  the issuer UUID from App Store Connect > Users
#   ASC_API_KEY_CONTENT    the full .p8 file contents, newlines included
#
# Signing needs MATCH_GIT_URL and MATCH_PASSWORD as well. See the Matchfile.
#
# Run from the repo root, not from app/: the Xcode project lives one level
# down and every path below is written relative to the root.

default_platform(:ios)

XCODEPROJ = "app/HexNFC.xcodeproj"
SCHEME    = "HexNFC"
OUTPUT    = "app/build"

platform :ios do
  # The API key object, built once and reused. Passing key_content directly
  # keeps the .p8 out of the filesystem entirely, so there is no stray private
  # key left on the runner for a later step to pick up.
  def asc_key
    @asc_key ||= app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_KEY_ID"),
      issuer_id: ENV.fetch("ASC_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_CONTENT"),
      is_key_content_base64: false,
      in_house: false
    )
  end

  desc "Fetch the App Store signing assets (read only)"
  lane :signing do
    match(type: "appstore", readonly: true, api_key: asc_key)
  end

  desc "Build a signed App Store IPA and upload it to TestFlight"
  lane :beta do
    signing

    # TestFlight rejects a build number it has seen before, and
    # CURRENT_PROJECT_VERSION is pinned at 1 in the project, so the number has
    # to come from somewhere authoritative at build time. Ask App Store Connect
    # what the highest build is and go one past it. BUILD_NUMBER overrides for
    # a manual re-run, and the rescue covers the very first upload, when the
    # app has no builds to be later than.
    build = ENV["BUILD_NUMBER"] || begin
      (latest_testflight_build_number(api_key: asc_key) + 1).to_s
    rescue StandardError
      "1"
    end
    increment_build_number(xcodeproj: XCODEPROJ, build_number: build)
    UI.message("Building #{SCHEME} build #{build}")

    gym(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT,
      output_name: "#{SCHEME}.ipa",
      clean: true,
      include_symbols: true,
      include_bitcode: false
    )

    pilot(
      api_key: asc_key,
      ipa: "#{OUTPUT}/#{SCHEME}.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build a signed IPA without uploading it. Use to prove signing works."
  lane :archive_only do
    signing
    gym(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT,
      output_name: "#{SCHEME}.ipa",
      clean: true
    )
  end
end
